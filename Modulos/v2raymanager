                v2ray_opt "5" "DESINSTALAR V2RAY"
                v2ray_opt "6" "VOLVER <<<"
            else
                v2ray_opt "1" "INSTALAR V2RAY" "$xv2ray"
                v2ray_opt "0" "VOLVER <<<"
            fi
            v2ray_line
            tput civis
            echo -ne "${SSHPLUS_CYAN}Opcion:${SCOLOR} "
            read x
            tput cnorm
            clear
            if [[ "$v2ray_running" != "1" ]]; then
                case $x in
                1 | 01)
                    intallv2ray
                    ;;
                0 | 00)
                    connection
                    exit
                    ;;
                *)
                    echo -e "\033[1;31mOpcion no valida!\033[0m"
