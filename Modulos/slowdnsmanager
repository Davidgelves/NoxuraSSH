#!/bin/bash
# lang=es slowdnsmanager

NC='\033[0m'
WHITE='\033[1;37m'
RED='\033[1;31m'
GREEN='\033[1;32m'
DARK_GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;38;2;76;228;255m'
NEON='\033[1;38;2;0;255;127m'

SLOW_DIR="/etc/slowdns"
SLOW_CONF="${SLOW_DIR}/slowdns.conf"
SLOW_KEY="${SLOW_DIR}/server.key"
SLOW_PUB="${SLOW_DIR}/server.pub"
SLOW_BIN="/usr/local/bin/dnstt-server"
SLOW_SERVICE="/etc/systemd/system/slowdns.service"
SLOW_LOG="/var/log/slowdns.log"
SLOW_PORT_DEFAULT="5300"
SLOW_TRAFFIC_DEFAULT="22"
SLOW_DOMAIN_DEFAULT="ns.example.com"

slow_line() {
	echo -e "${CYAN}============================================================${NC}"
}

slow_title() {
	local title="$1" pad
	slow_line
	pad=$(( (60 - ${#title}) / 2 ))
	[[ "$pad" -lt 0 ]] && pad=0
	printf '%*s%b%s%b\n' "$pad" "" "$CYAN" "$title" "$NC"
	slow_line
}

slow_opt() {
	echo -e "${NEON}[$1]${NC} ${CYAN}>${NC} ${WHITE}$2${NC} $3"
}

slow_pause() {
	echo -ne "\n${YELLOW}* ${WHITE}Enter para continuar${NC}"
	read -r _
}

slow_load_conf() {
	SLOW_PORT="$SLOW_PORT_DEFAULT"
	SLOW_TRAFFIC="$SLOW_TRAFFIC_DEFAULT"
	SLOW_DOMAIN="$SLOW_DOMAIN_DEFAULT"
	SLOW_REDIRECT="53"
	[[ -f "$SLOW_CONF" ]] && . "$SLOW_CONF" 2>/dev/null || true
}

slow_save_conf() {
	mkdir -p "$SLOW_DIR"
	cat > "$SLOW_CONF" <<EOF
SLOW_PORT="${SLOW_PORT:-$SLOW_PORT_DEFAULT}"
SLOW_TRAFFIC="${SLOW_TRAFFIC:-$SLOW_TRAFFIC_DEFAULT}"
SLOW_DOMAIN="${SLOW_DOMAIN:-$SLOW_DOMAIN_DEFAULT}"
SLOW_REDIRECT="${SLOW_REDIRECT:-53}"
EOF
	chmod 644 "$SLOW_CONF"
}

slow_detect_arch() {
	case "$(uname -m)" in
		x86_64|amd64) echo "amd64" ;;
		aarch64|arm64) echo "arm64" ;;
		armv7l|armhf) echo "arm" ;;
		*) return 1 ;;
	esac
}

slow_install_deps() {
	if command -v apt-get >/dev/null 2>&1; then
		apt-get update -y >/dev/null 2>&1 || true
		apt-get install -y curl wget iptables net-tools ca-certificates >/dev/null 2>&1 || true
	fi
}

slow_download_bin() {
	local arch url tmp
	arch="$(slow_detect_arch)" || {
		echo -e "${RED}Arquitectura no soportada: $(uname -m)${NC}"
		return 1
	}
	url="https://dnstt.network/dnstt-server-linux-${arch}"
	tmp="/tmp/dnstt-server.$$"
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL -o "$tmp" "$url" || true
	fi
	if [[ ! -s "$tmp" ]] && command -v wget >/dev/null 2>&1; then
		wget -qO "$tmp" "$url" || true
	fi
	[[ -s "$tmp" ]] || {
		echo -e "${RED}No se pudo descargar dnstt-server.${NC}"
		return 1
	}
	chmod +x "$tmp"
	mv -f "$tmp" "$SLOW_BIN"
	chmod +x "$SLOW_BIN"
}

slow_generate_keys() {
	mkdir -p "$SLOW_DIR"
	[[ -x "$SLOW_BIN" ]] || slow_download_bin || return 1
	"$SLOW_BIN" -gen-key -privkey-file "$SLOW_KEY" -pubkey-file "$SLOW_PUB" >/dev/null 2>&1
	chmod 600 "$SLOW_KEY"
	chmod 644 "$SLOW_PUB"
}

slow_write_service() {
	cat > "$SLOW_SERVICE" <<EOF
[Unit]
Description=SSHPlus SlowDNS DNSTT Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${SLOW_BIN} -udp :${SLOW_PORT} -privkey-file ${SLOW_KEY} ${SLOW_DOMAIN} 127.0.0.1:${SLOW_TRAFFIC}
Restart=always
RestartSec=3
StandardOutput=append:${SLOW_LOG}
StandardError=append:${SLOW_LOG}

[Install]
WantedBy=multi-user.target
EOF
	systemctl daemon-reload >/dev/null 2>&1 || true
}

slow_apply_redirect() {
	iptables -t nat -D PREROUTING -p udp --dport "${SLOW_REDIRECT:-53}" -j REDIRECT --to-ports "$SLOW_PORT" >/dev/null 2>&1 || true
	iptables -t nat -A PREROUTING -p udp --dport "${SLOW_REDIRECT:-53}" -j REDIRECT --to-ports "$SLOW_PORT" >/dev/null 2>&1 || true
}

slow_restart() {
	slow_load_conf
	slow_write_service
	slow_apply_redirect
	systemctl enable slowdns >/dev/null 2>&1 || true
	systemctl restart slowdns >/dev/null 2>&1 || true
}

slow_status_text() {
	if systemctl is-active --quiet slowdns 2>/dev/null; then
		echo -e "${GREEN}[ON]${NC}"
	else
		echo -e "${RED}[OFF]${NC}"
	fi
}

slow_configure() {
	clear
	slow_title "CONFIGURAR SLOWDNS"
	slow_load_conf
	echo -ne "${DARK_GREEN}PUERTO SLOWDNS:${NC} "; read -r new_port
	echo -ne "${DARK_GREEN}PUERTO DE TRAFICO:${NC} "; read -r new_traffic
	echo -ne "${DARK_GREEN}DOMINIO NS:${NC} "; read -r new_domain
	[[ -n "$new_port" ]] && SLOW_PORT="$new_port"
	[[ -n "$new_traffic" ]] && SLOW_TRAFFIC="$new_traffic"
	[[ -n "$new_domain" ]] && SLOW_DOMAIN="$new_domain"
	SLOW_REDIRECT="53"
	slow_install_deps
	[[ -x "$SLOW_BIN" ]] || slow_download_bin || { slow_pause; return; }
	[[ -f "$SLOW_KEY" && -f "$SLOW_PUB" ]] || slow_generate_keys || { slow_pause; return; }
	slow_save_conf
	slow_restart
	echo -e "\n${GREEN}SLOWDNS configurado correctamente.${NC}"
	slow_pause
}

slow_show_keys() {
	clear
	slow_title "CLAVES SLOWDNS"
	[[ -f "$SLOW_PUB" ]] && echo -e "${DARK_GREEN}CLAVE PUB:${NC} ${GREEN}$(cat "$SLOW_PUB")${NC}" || echo -e "${RED}No existe clave publica.${NC}"
	[[ -f "$SLOW_KEY" ]] && echo -e "${DARK_GREEN}CLAVE PRIV:${NC} ${WHITE}${SLOW_KEY}${NC}" || echo -e "${RED}No existe clave privada.${NC}"
	slow_line
	slow_pause
}

slow_custom_keys() {
	clear
	slow_title "PAR DE CLAVES PERSONALES"
	mkdir -p "$SLOW_DIR"
	echo -ne "${DARK_GREEN}CLAVE PRIVADA:${NC} "; read -r priv
	echo -ne "${DARK_GREEN}CLAVE PUBLICA:${NC} "; read -r pub
	[[ -z "$priv" || -z "$pub" ]] && echo -e "${RED}Datos incompletos.${NC}" && slow_pause && return
	echo "$priv" > "$SLOW_KEY"
	echo "$pub" > "$SLOW_PUB"
	chmod 600 "$SLOW_KEY"
	chmod 644 "$SLOW_PUB"
	slow_restart
	echo -e "${GREEN}Claves actualizadas.${NC}"
	slow_pause
}

slow_change_traffic() {
	slow_load_conf
	echo -ne "${DARK_GREEN}PUERTO DE TRAFICO:${NC} "; read -r SLOW_TRAFFIC
	[[ -z "$SLOW_TRAFFIC" ]] && return
	slow_save_conf
	slow_restart
}

slow_change_domain() {
	slow_load_conf
	echo -ne "${DARK_GREEN}DOMINIO NS:${NC} "; read -r SLOW_DOMAIN
	[[ -z "$SLOW_DOMAIN" ]] && return
	slow_save_conf
	slow_restart
}

slow_service_status() {
	clear
	slow_title "ESTADO SLOWDNS"
	systemctl status slowdns --no-pager 2>/dev/null || echo -e "${RED}Servicio no instalado.${NC}"
	slow_pause
}

slow_toggle() {
	if systemctl is-active --quiet slowdns 2>/dev/null; then
		systemctl stop slowdns >/dev/null 2>&1
	else
		slow_restart
	fi
}

slow_logs() {
	clear
	slow_title "LOG SLOWDNS"
	journalctl -u slowdns -n 80 --no-pager 2>/dev/null || tail -n 80 "$SLOW_LOG" 2>/dev/null
	slow_pause
}

slow_logs_live() {
	clear
	slow_title "LOG SLOWDNS EN TIEMPO REAL"
	journalctl -u slowdns -f 2>/dev/null || tail -f "$SLOW_LOG" 2>/dev/null
}

slow_uninstall() {
	clear
	slow_title "DESINSTALAR SLOWDNS"
	echo -ne "${DARK_GREEN}CONFIRMAR DESINSTALACION [s/n]:${NC} "; read -r resp
	[[ "$resp" =~ ^[sS]$ ]] || return
	systemctl stop slowdns >/dev/null 2>&1 || true
	systemctl disable slowdns >/dev/null 2>&1 || true
	rm -f "$SLOW_SERVICE"
	systemctl daemon-reload >/dev/null 2>&1 || true
	iptables -t nat -D PREROUTING -p udp --dport "${SLOW_REDIRECT:-53}" -j REDIRECT --to-ports "$SLOW_PORT" >/dev/null 2>&1 || true
	rm -rf "$SLOW_DIR" "$SLOW_LOG"
	echo -e "${GREEN}SlowDNS desinstalado.${NC}"
	slow_pause
}

slow_summary() {
	slow_load_conf
	echo -e "${DARK_GREEN}PORT:${NC} ${GREEN}${SLOW_PORT}${NC}"
	echo -e "${DARK_GREEN}REDIRECT:${NC} ${GREEN}${SLOW_REDIRECT:-53} > ${SLOW_PORT}${NC}"
	echo -e "${DARK_GREEN}TRAFIC PORT:${NC} ${GREEN}${SLOW_TRAFFIC}${NC}"
	echo -e "${DARK_GREEN}NS DOMAIN:${NC} ${GREEN}${SLOW_DOMAIN}${NC}"
	if [[ -f "$SLOW_PUB" ]]; then
		echo -e "${DARK_GREEN}CLAVE PUB:${NC} ${GREEN}$(cat "$SLOW_PUB")${NC}"
	else
		echo -e "${DARK_GREEN}CLAVE PUB:${NC} ${WHITE}N/A${NC}"
	fi
}

while true; do
	clear
	if [[ ! -f "$SLOW_CONF" ]]; then
		slow_line
		echo -e "${CYAN}                       UDP-SLOWDNS${NC}"
		slow_line
		slow_opt "1" "INSTALAR SLOWDNS"
		slow_line
		slow_opt "0" "Volver"
	else
		slow_title "UDP-SLOWDNS"
		slow_summary
		slow_line
		slow_opt "1" "RECONFIGURAR SLOWDNS"
		slow_line
		slow_opt "2" "MIS CLAVES SLOWDNS"
		slow_opt "3" "GENERAR NUEVO PAR DE CLAVES"
		slow_opt "4" "PAR DE CLAVES PERSONALES"
		slow_line
		slow_opt "5" "MODIFICAR PUERTO DE TRAFICO"
		slow_opt "6" "MODIFICAR DOMINIO NS"
		slow_line
		slow_opt "7" "ESTADO DEL SERVICIO"
		slow_opt "8" "REINICIAR SERVICIO"
		slow_opt "9" "INICIAR/PARAR SERVICIO" "$(slow_status_text)"
		slow_line
		slow_opt "10" "LOG SLOWDNS"
		slow_opt "11" "LOG SLOWDNS EN TIEMPO REAL"
		slow_line
		printf "%b  %b  %b\n" "${NEON}[0]${NC} ${CYAN}>${NC} ${WHITE}Volver${NC}" "${NEON}[12]${NC} ${CYAN}>${NC} ${WHITE}REINSTALAR${NC}" "${NEON}[13]${NC} ${CYAN}>${NC} ${WHITE}DESINSTALAR${NC}"
	fi
	slow_line
	echo -ne "${DARK_GREEN}Opcion:${NC} "
	read -r opt
	case "$opt" in
		1) slow_configure ;;
		2) [[ -f "$SLOW_CONF" ]] && slow_show_keys ;;
		3) [[ -f "$SLOW_CONF" ]] && slow_generate_keys && slow_restart && echo -e "${GREEN}Nuevo par de claves generado.${NC}" && slow_pause ;;
		4) [[ -f "$SLOW_CONF" ]] && slow_custom_keys ;;
		5) [[ -f "$SLOW_CONF" ]] && slow_change_traffic ;;
		6) [[ -f "$SLOW_CONF" ]] && slow_change_domain ;;
		7) [[ -f "$SLOW_CONF" ]] && slow_service_status ;;
		8) [[ -f "$SLOW_CONF" ]] && slow_restart && echo -e "${GREEN}Servicio reiniciado.${NC}" && slow_pause ;;
		9) [[ -f "$SLOW_CONF" ]] && slow_toggle ;;
		10) [[ -f "$SLOW_CONF" ]] && slow_logs ;;
		11) [[ -f "$SLOW_CONF" ]] && slow_logs_live ;;
		12) [[ -f "$SLOW_CONF" ]] && slow_download_bin && slow_configure ;;
		13) [[ -f "$SLOW_CONF" ]] && slow_load_conf && slow_uninstall ;;
		0) conexao; exit ;;
	esac
done
