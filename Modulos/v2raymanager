                menu_usuarios_v2ray
                ;;
            2 | 02)
                ajustes_v2ray
                ;;
            3 | 03)
                reiniciar_v2ray
                ;;
            5 | 05)
                unistallv2
                ;;
            6 | 06)
                connection
