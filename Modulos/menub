#!/bin/bash
# lang=es menub
[[ -f /bin/sshplus_lang ]] && . /bin/sshplus_lang
_menub_status_mark() {
	pgrep -f "$1" >/dev/null 2>&1 && printf '\033[1;32mo\033[0m' || printf '\033[1;31mx\033[0m'
}
while true; do
	stsu="$(_menub_status_mark udpvpn)"
	clear
	echo -e "\033[01;31m║\033[1;31m\033[5;34;47m                    MENU BADVPN                    \033[1;33m \033[0m\033[01;31m║"
	echo -e "\033[01;31m║\033[0m"
	echo -e "\033[01;31m║\033[1;31m\033[1;34m[\033[1;37m 01 •\033[1;34m]\033[1;37m ➩  \033[1;33mBADVPN PRO ${stsu:-}\033[0m"
	echo -e "\033[01;31m║\033[1;31m\033[1;34m[\033[1;37m 02 •\033[1;34m]\033[1;37m ➩  \033[1;33mBADVPN 2 \033[0m"
	echo -e "\033[01;31m║\033[1;31m\033[1;34m[\033[1;37m 03 •\033[1;34m]\033[1;37m ➩  \033[1;33mBADVPN 3 \033[0m"
	echo -e "\033[01;31m║\033[1;31m\033[1;34m[\033[1;37m 04 •\033[1;34m]\033[1;37m ➩  \033[1;33mBADVPN 4 ACKHTTP \033[0m"
	echo -e "\033[01;31m║\033[1;31m\033[1;34m[\033[1;37m 00 •\033[1;34m]\033[1;37m ➩  \033[1;33mVOLVER  \033[1;32m<\033[1;33m<\033[1;31m< \033[0m"
	echo -e "\033[01;31m║\033[0m"
	echo -e "\033[0;31m╠━━═━═━═━═━═━═━═━═━━═━═━═━═━═━━═━═━═━═━═━━═━═━═━═━═━\033[0m"
	tput civis
	echo -ne "\033[1;31m╰━━━━━━━━❪\033[1;32mELIJA OPCION DESEADA\033[1;33m\033[1;31m\033[1;37m : "
	read x
	tput cnorm
	clear
	case $x in
	1 | 01)
		badvpn
		;;
	2 | 02)
		badvpn2
		;;
	3 | 03)
		badpro1
		;;
	4 | 04)
		badvpn3
		;;
	0 | 00)
		clear
		menu
		break
		;;
	*)
		echo -e "\033[1;31m${L_OPC_INVALIDA:-Opcion no valida!}\033[0m"
		sleep 2
		;;
	esac
done
