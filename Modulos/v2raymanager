    cp /etc/v2ray/config.json /etc/v2ray/config.json.bak-$(date +%s)
    if command -v nano >/dev/null 2>&1; then
    nano /etc/v2ray/config.json
    else
    vi /etc/v2ray/config.json
    fi
    v2ray restart > /dev/null 2>&1
