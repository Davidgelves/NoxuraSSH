        [[ -e $HOME/fim ]] && rm $HOME/fim
        ${comando[0]} -y >/dev/null 2>&1
        ${comando[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    printf "${CYAN}>${RESET} ${WHITE}ESPERE${RESET} ${CYAN}|"
    while true; do
        for ((i = 0; i < 18; i++)); do
            printf "#"
            sleep 0.1s
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        printf "${CYAN}|${RESET}\n"
        sleep 1s
