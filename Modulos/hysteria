#!/bin/bash
# Hysteria 2 manager for SSH-Plus

NC='\033[0m'
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[38;2;76;228;255m'

HYST_BIN="/usr/local/bin/hysteria"
HYST_DIR="/etc/hysteria"
HYST_CONF="${HYST_DIR}/config.yaml"
HYST_ENV="${HYST_DIR}/sshplus.env"
HYST_CERT="${HYST_DIR}/server.crt"
HYST_KEY="${HYST_DIR}/server.key"
HYST_IPTABLES="${HYST_DIR}/iptables.sh"
HYST_SERVICE="/etc/systemd/system/hysteria-server.service"

hyst_clear() {
	printf '\033c\033[3J\033[H\033[2J'
}

hyst_line() {
	echo -e "${CYAN}============================================================${NC}"
}

hyst_pause() {
	echo -ne "\n${RED}ENTER ${YELLOW}para volver${NC}"
	read -r _
}

hyst_rand() {
	tr -dc 'A-Za-z0-9' </dev/urandom | head -c "${1:-16}"
}

hyst_public_ip() {
	curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'
}

hyst_load_env() {
	[[ -f "$HYST_ENV" ]] && . "$HYST_ENV"
}

hyst_client_ranges() {
	local value="${1// /}"
	echo "${value//:/-}"
}

hyst_migrate_old_port() {
	hyst_load_env
	if [[ "${HYST_PORT:-}" = "1" && -n "${HYST_RULES:-}" ]]; then
		hyst_write_config "36712" "$HYST_RULES" "${HYST_OBFS:-$(hyst_rand 18)}" || return 0
		hyst_write_service
		systemctl restart hysteria-server >/dev/null 2>&1
	elif grep -q 'type: password' "$HYST_CONF" 2>/dev/null || grep -q '^HYST_USER=' "$HYST_ENV" 2>/dev/null; then
		hyst_write_config "${HYST_PORT:-36712}" "${HYST_RULES:-1:65535}" "${HYST_OBFS:-$(hyst_rand 18)}" || return 0
		hyst_write_service
		systemctl restart hysteria-server >/dev/null 2>&1
	fi
}

hyst_status_mark() {
	systemctl is-active --quiet hysteria-server 2>/dev/null && echo -e "${GREEN}o${NC}" || echo -e "${RED}x${NC}"
}

hyst_valid_port() {
	local value="$1"
	[[ "$value" =~ ^[0-9]+$ ]] || return 1
	(( value >= 1 && value <= 65535 ))
}

hyst_valid_range() {
	local value="$1" first last
	[[ "$value" =~ ^[0-9]+(-[0-9]+)?$ ]] || return 1
	first="${value%-*}"
	last="${value#*-}"
	[[ "$value" != *-* ]] && last="$first"
	(( first >= 1 && first <= 65535 && last >= 1 && last <= 65535 && first <= last ))
}

hyst_valid_rule_ranges() {
	local value="${1// /}" item first last
	[[ -n "$value" ]] || return 1
	IFS=',' read -ra _items <<<"$value"
	for item in "${_items[@]}"; do
		[[ "$item" =~ ^[0-9]+(:[0-9]+)?$ ]] || return 1
		first="${item%%:*}"
		last="${item##*:}"
		[[ "$item" != *:* ]] && last="$first"
		(( first >= 1 && first <= 65535 && last >= 1 && last <= 65535 && first <= last )) || return 1
	done
}

hyst_yaml_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

hyst_shell_quote() {
	printf '%q' "$1"
}

hyst_build_userpass() {
	local db="/root/usuarios.db" pass_dir="/etc/SSHPlus/senha" user pass found=0
	[[ -f "$db" ]] || return 1
	while read -r user _; do
		[[ -z "$user" ]] && continue
		[[ -f "$pass_dir/$user" ]] || continue
		pass="$(cat "$pass_dir/$user" 2>/dev/null)"
		[[ -z "$pass" ]] && continue
		printf '    %s: %s\n' "$(hyst_yaml_quote "$user")" "$(hyst_yaml_quote "$pass")"
		found=1
	done <"$db"
	[[ "$found" = "1" ]]
}

hyst_install_binary() {
	if [[ -x /usr/local/bin/hysteria ]]; then
		HYST_BIN="/usr/local/bin/hysteria"
		return 0
	fi
	if [[ -x /usr/bin/hysteria ]]; then
		HYST_BIN="/usr/bin/hysteria"
		return 0
	fi
	echo -e "${YELLOW}Descargando Hysteria 2...${NC}"
	if command -v curl >/dev/null 2>&1; then
		bash <(curl -fsSL https://get.hy2.sh/)
	elif command -v wget >/dev/null 2>&1; then
		bash <(wget -qO- https://get.hy2.sh/)
	else
		echo -e "${RED}Necesita curl o wget para instalar Hysteria.${NC}"
		return 1
	fi
	[[ -x /usr/local/bin/hysteria ]] && HYST_BIN="/usr/local/bin/hysteria"
	[[ -x "$HYST_BIN" ]]
}

hyst_write_service() {
	cat >"$HYST_SERVICE" <<EOF
[Unit]
Description=Hysteria 2 Server - SSH Plus
After=network.target

[Service]
Type=simple
ExecStart=${HYST_BIN} server -c ${HYST_CONF}
ExecStartPre=${HYST_IPTABLES} apply
ExecStopPost=${HYST_IPTABLES} clear
WorkingDirectory=${HYST_DIR}
Restart=on-failure
RestartSec=5
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
EOF
	systemctl daemon-reload >/dev/null 2>&1
	systemctl enable hysteria-server >/dev/null 2>&1
}

hyst_write_config() {
	local port="$1" rules="$2" obfs="$3" userpass_block
	userpass_block="$(hyst_build_userpass)" || return 2
	mkdir -p "$HYST_DIR"
	if [[ ! -f "$HYST_CERT" || ! -f "$HYST_KEY" ]]; then
		openssl req -x509 -newkey rsa:2048 -days 3650 -nodes \
			-keyout "$HYST_KEY" -out "$HYST_CERT" -subj "/CN=sshplus-hysteria" >/dev/null 2>&1
	fi
	cat >"$HYST_CONF" <<EOF
listen: :${port}

tls:
  cert: ${HYST_CERT}
  key: ${HYST_KEY}

auth:
  type: userpass
  userpass:
${userpass_block}

obfs:
  type: salamander
  salamander:
    password: ${obfs}

masquerade:
  type: proxy
  proxy:
    url: https://www.bing.com/
    rewriteHost: true
EOF
	cat >"$HYST_ENV" <<EOF
HYST_PORT=$(hyst_shell_quote "$port")
HYST_RULES=$(hyst_shell_quote "$rules")
HYST_OBFS=$(hyst_shell_quote "$obfs")
EOF
	cat >"$HYST_IPTABLES" <<'EOF'
#!/bin/bash
ACTION="$1"
ENV_FILE="/etc/hysteria/sshplus.env"
CHAIN="SSHPLUS_HYSTERIA"

[[ -f "$ENV_FILE" ]] && . "$ENV_FILE"

clear_rules() {
	while iptables -t nat -C PREROUTING -p udp -j "$CHAIN" >/dev/null 2>&1; do
		iptables -t nat -D PREROUTING -p udp -j "$CHAIN" >/dev/null 2>&1 || break
	done
	iptables -t nat -F "$CHAIN" >/dev/null 2>&1 || true
	iptables -t nat -X "$CHAIN" >/dev/null 2>&1 || true
}

apply_rules() {
	clear_rules
	iptables -t nat -N "$CHAIN" >/dev/null 2>&1 || true
	iptables -t nat -A PREROUTING -p udp -j "$CHAIN" >/dev/null 2>&1 || true
	local clean="${HYST_RULES// /}" item
	IFS=',' read -ra items <<<"$clean"
	for item in "${items[@]}"; do
		[[ -z "$item" ]] && continue
		iptables -t nat -A "$CHAIN" -p udp --dport "$item" -j REDIRECT --to-ports "$HYST_PORT" >/dev/null 2>&1 || true
	done
}

case "$ACTION" in
	apply) apply_rules ;;
	clear) clear_rules ;;
esac
EOF
	chmod +x "$HYST_IPTABLES" 2>/dev/null
	chmod 600 "$HYST_CONF" "$HYST_ENV" "$HYST_KEY" 2>/dev/null
}

hyst_sync_users() {
	[[ -f "$HYST_ENV" ]] || return 0
	hyst_load_env
	if ! hyst_build_userpass >/dev/null; then
		systemctl stop hysteria-server >/dev/null 2>&1 || true
		return 0
	fi
	hyst_write_config "${HYST_PORT:-36712}" "${HYST_RULES:-1:65535}" "${HYST_OBFS:-$(hyst_rand 18)}" || return 0
	systemctl restart hysteria-server >/dev/null 2>&1 || true
}

hyst_show_info() {
	hyst_migrate_old_port
	hyst_load_env
	local ip
	ip="$(hyst_public_ip)"
	echo -e "${GREEN}Puerto principal:${NC} ${HYST_PORT:-N/A}"
	echo -e "${GREEN}Rangos iptables:${NC} ${HYST_RULES:-N/A}"
	echo -e "${GREEN}OBFS:${NC} ${HYST_OBFS:-N/A}"
	echo -e "${GREEN}Servidor:${NC} ${ip:-IP_DEL_VPS}:$(hyst_client_ranges "${HYST_RULES:-${HYST_PORT:-PUERTO}}")"
	echo -e "${YELLOW}TLS usa certificado propio; en el cliente active insecure/allowInsecure.${NC}"
}

hyst_configure() {
	hyst_clear
	echo -e "${BLUE}                 INSTALAR HYSTERIA UDP${NC}"
	hyst_line
	local port rules obfs
	if ! hyst_build_userpass >/dev/null; then
		echo -e "${RED}No hay usuarios SSH con contrasena guardada.${NC}"
		echo -e "${YELLOW}Cree usuarios desde el menu principal y vuelva a instalar Hysteria.${NC}"
		hyst_pause
		return
	fi
	echo -ne "${GREEN}Puerto principal Hysteria [36712]: ${NC}"
	read -r port
	[[ -z "$port" ]] && port="36712"
	if ! hyst_valid_port "$port"; then
		echo -e "${RED}Puerto invalido.${NC}"
		sleep 2
		return
	fi
	echo -ne "${GREEN}Rangos iptables UDP [1:65535]: ${NC}"
	read -r rules
	[[ -z "$rules" ]] && rules="1:65535"
	if ! hyst_valid_rule_ranges "$rules"; then
		echo -e "${RED}Rangos invalidos. Ejemplo: 1:52,54:5299,5301:65535${NC}"
		sleep 2
		return
	fi
	echo -ne "${GREEN}OBFS salamander [aleatorio]: ${NC}"
	read -r obfs
	[[ -z "$obfs" ]] && obfs="$(hyst_rand 18)"
	hyst_install_binary || {
		hyst_pause
		return
	}
	hyst_write_config "$port" "$rules" "$obfs" || {
		echo -e "${RED}No se pudo sincronizar usuarios SSH para Hysteria.${NC}"
		hyst_pause
		return
	}
	hyst_write_service
	systemctl restart hysteria-server >/dev/null 2>&1
	hyst_line
	echo -e "${GREEN}Hysteria instalado/configurado.${NC}"
	hyst_show_info
	hyst_pause
}

hyst_change_obfs() {
	hyst_load_env
	echo -ne "${GREEN}Nuevo OBFS salamander: ${NC}"
	read -r new_obfs
	[[ -z "$new_obfs" ]] && return
	hyst_write_config "${HYST_PORT:-36712}" "${HYST_RULES:-1:65535}" "$new_obfs"
	systemctl restart hysteria-server >/dev/null 2>&1
}

hyst_change_range() {
	while true; do
		hyst_clear
		echo -e "${BLUE}                 RANGOS IPTABLES HYSTERIA${NC}"
		hyst_line
		hyst_load_env
		echo -e "${GREEN}Puerto principal:${NC} ${HYST_PORT:-36712}"
		echo -e "${GREEN}Reglas actuales:${NC} ${HYST_RULES:-1:65535}"
		hyst_line
		echo -e "${GREEN}[1]${NC} => MODIFICAR RANGO IPTABLE"
		echo -e "${GREEN}[2]${NC} => PONER REGLA DE RANGOS IPTABLES"
		echo -e "${GREEN}[0]${NC} => VOLVER"
		hyst_line
		echo -ne "${GREEN}ELIJA OPCION DESEADA${YELLOW} : ${NC}"
		read -r range_opt
		case "$range_opt" in
			1)
				local from_port to_port new_rules
				echo -ne "${GREEN}Desde puerto [1]: ${NC}"
				read -r from_port
				[[ -z "$from_port" ]] && from_port="1"
				echo -ne "${GREEN}Hasta puerto [65535]: ${NC}"
				read -r to_port
				[[ -z "$to_port" ]] && to_port="65535"
				new_rules="${from_port}:${to_port}"
				if ! hyst_valid_rule_ranges "$new_rules"; then
					echo -e "${RED}Rango invalido.${NC}"
					sleep 2
					continue
				fi
				hyst_write_config "${HYST_PORT:-36712}" "$new_rules" "${HYST_OBFS:-$(hyst_rand 18)}"
				systemctl restart hysteria-server >/dev/null 2>&1
				;;
			2)
				echo -ne "${GREEN}Reglas de rangos iptables [1:52,54:5299,5301:65535]: ${NC}"
				read -r new_rules
				[[ -z "$new_rules" ]] && new_rules="1:52,54:5299,5301:65535"
				if ! hyst_valid_rule_ranges "$new_rules"; then
					echo -e "${RED}Reglas invalidas.${NC}"
					sleep 2
					continue
				fi
				hyst_write_config "${HYST_PORT:-36712}" "$new_rules" "${HYST_OBFS:-$(hyst_rand 18)}"
				systemctl restart hysteria-server >/dev/null 2>&1
				;;
			0|00) return ;;
			*) echo -e "${RED}Opcion no valida.${NC}"; sleep 1 ;;
		esac
	done
}

hyst_toggle_service() {
	if systemctl is-active --quiet hysteria-server 2>/dev/null; then
		systemctl stop hysteria-server
		echo -e "${YELLOW}Hysteria detenido.${NC}"
	else
		systemctl start hysteria-server
		echo -e "${GREEN}Hysteria iniciado.${NC}"
	fi
	sleep 2
}

hyst_menu() {
	while true; do
		hyst_clear
		echo -e "${BLUE}                       HYSTERIA UDP${NC}"
		hyst_line
		echo -e "${GREEN}Estado:${NC} $(hyst_status_mark)"
		[[ -f "$HYST_ENV" ]] && hyst_show_info
		hyst_line
		if [[ ! -f "$HYST_CONF" ]]; then
			echo -e "${GREEN}[1]${NC} => INSTALAR HYSTERIA"
			echo -e "${GREEN}[0]${NC} => VOLVER"
		else
			echo -e "${GREEN}[1]${NC} => VOLVER A CONFIGURAR UDP HYSTERIA"
			echo -e "${GREEN}[2]${NC} => MODIFICAR OBFS"
			echo -e "${GREEN}[3]${NC} => MODIFICAR RANGOS IPTABLE (1-65535)"
			echo -e "${GREEN}[4]${NC} => REINICIAR SERVICIO"
			echo -e "${GREEN}[5]${NC} => DETENER/INICIAR SERVICIO"
			echo -e "${GREEN}[0]${NC} => VOLVER"
		fi
		hyst_line
		echo -ne "${GREEN}ELIJA OPCION DESEADA${YELLOW} : ${NC}"
		read -r opt
		case "$opt" in
			1) hyst_configure ;;
			2) [[ -f "$HYST_CONF" ]] && hyst_change_obfs ;;
			3) [[ -f "$HYST_CONF" ]] && hyst_change_range ;;
			4) [[ -f "$HYST_CONF" ]] && systemctl restart hysteria-server && sleep 1 ;;
			5) [[ -f "$HYST_CONF" ]] && hyst_toggle_service ;;
			0|00) clear; conexao; exit ;;
			*) echo -e "${RED}Opcion no valida.${NC}"; sleep 1 ;;
		esac
	done
}

case "${1:-}" in
	--sync) hyst_sync_users ;;
	*) hyst_menu ;;
esac
